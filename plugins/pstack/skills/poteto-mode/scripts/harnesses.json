{
  "claude": {
    "command": "claude",
    "providers": { "anthropic": "{model}" },
    "kind": "claude",
    "promptFirst": true,
    "model": ["--model", "{model}"],
    "effort": ["--effort", "{effort}"],
    "efforts": ["low", "medium", "high", "xhigh", "max"],
    "runDir": ["--add-dir", "{run}"],
    "access": {
      "read": [
        "--permission-mode",
        "dontAsk",
        "--allowedTools",
        "Read,Grep,Glob,Edit(/{run}/question.md),Edit(/{run}/result.md),Bash(git diff:*),Bash(git log:*),Bash(git show:*),Bash(git status:*),Bash(git blame:*),Bash(git rev-parse:*),Bash(git ls-files:*),Bash(git grep:*),Bash(rg:*),Bash(ls:*),Bash(wc:*),Bash(node {script} ask-parent:*)",
        "--disallowedTools",
        "AskUserQuestion"
      ],
      "write": [
        "--permission-mode",
        "dontAsk",
        "--allowedTools",
        "Read,Grep,Glob,Edit,Write,Bash",
        "--disallowedTools",
        "AskUserQuestion"
      ]
    },
    "t3": { "driver": "claudeAgent", "options": { "effort": "{effort}" } }
  },
  "codex": {
    "command": "codex",
    "providers": { "openai": "{model}" },
    "kind": "codex",
    "promptFirst": false,
    "model": ["-m", "{model}"],
    "effort": ["-c", "model_reasoning_effort={effort}"],
    "efforts": null,
    "runDir": ["--add-dir", "{run}"],
    "access": {
      "read": [
        "-a",
        "never",
        "-s",
        "workspace-write",
        "-c",
        "sandbox_workspace_write.network_access=true"
      ],
      "write": [
        "-a",
        "never",
        "-s",
        "workspace-write",
        "-c",
        "sandbox_workspace_write.network_access=true"
      ]
    },
    "t3": { "driver": "codex", "options": { "reasoningEffort": "{effort}" } }
  },
  "grok": {
    "command": "grok",
    "providers": { "xai": "{model}" },
    "kind": "grok",
    "promptFirst": false,
    "model": ["-m", "{model}"],
    "effort": ["--reasoning-effort", "{effort}"],
    "efforts": ["low", "medium", "high", "xhigh"],
    "runDir": [],
    "access": {
      "read": ["--always-approve"],
      "write": ["--always-approve"]
    },
    "t3": { "driver": "grok", "options": { "reasoningEffort": "{effort}" } }
  },
  "agy": {
    "command": "agy",
    "providers": { "google": "{model}" },
    "kind": "agy",
    "promptFirst": false,
    "prompt": ["-i", "{prompt}"],
    "model": ["--model", "{model}"],
    "effort": null,
    "efforts": null,
    "runDir": ["--add-dir", "{run}"],
    "access": {
      "read": ["--dangerously-skip-permissions"],
      "write": ["--dangerously-skip-permissions"]
    },
    "t3": { "driver": "antigravity" }
  },
  "muse": {
    "command": "muse",
    "providers": { "meta": "{model}" },
    "kind": "muse",
    "promptFirst": false,
    "model": ["--model", "{model}"],
    "effort": ["--reasoning-effort", "{effort}"],
    "efforts": ["minimal", "low", "medium", "high", "xhigh", "max"],
    "runDir": [],
    "access": {
      "read": [
        "--approval-mode",
        "never",
        "--trust-workspace",
        "--sandbox-network",
        "enabled"
      ],
      "write": ["--yolo"]
    },
    "t3": { "driver": "muse", "options": { "reasoningEffort": "{effort}" } }
  },
  "pi": {
    "command": "pi",
    "providers": { "openai": "openai-codex/{model}" },
    "kind": "pi",
    "promptFirst": false,
    "model": ["--model", "{model}"],
    "effort": ["--thinking", "{effort}"],
    "efforts": ["off", "minimal", "low", "medium", "high", "xhigh", "max"],
    "runDir": [],
    "access": { "read": [], "write": [] }
  },
  "omp": {
    "command": "omp",
    "providers": {
      "meta": "muse-code/{model}",
      "openai": "openai-codex/{model}",
      "xai": "xai-oauth/{model}"
    },
    "kind": "omp",
    "promptFirst": false,
    "model": ["--model", "{model}"],
    "effort": ["--thinking", "{effort}"],
    "efforts": ["off", "minimal", "low", "medium", "high", "xhigh", "max"],
    "runDir": [],
    "access": { "read": ["--auto-approve"], "write": ["--auto-approve"] }
  },
  "opencode": {
    "command": "opencode",
    "providers": { "openai": "openai/{model}" },
    "kind": "opencode",
    "promptFirst": false,
    "prompt": ["--prompt", "{prompt}"],
    "model": ["-m", "{model}"],
    "effort": null,
    "efforts": null,
    "runDir": [],
    "access": { "read": ["--auto"], "write": ["--auto"] }
  }
}
