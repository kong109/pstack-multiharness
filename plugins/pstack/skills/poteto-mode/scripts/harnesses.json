{
  "claude": {
    "command": "claude",
    "kind": "claude",
    "promptFirst": true,
    "model": ["--model", "{model}"],
    "effort": ["--effort", "{effort}"],
    "efforts": ["low", "medium", "high", "xhigh", "max"],
    "runDir": ["--add-dir", "{run}"],
    "access": {
      "read": ["--permission-mode", "dontAsk", "--allowedTools", "Read,Grep,Glob,Edit(/{run}/question.md),Edit(/{run}/result.md),Bash(git diff:*),Bash(git log:*),Bash(git show:*),Bash(git status:*),Bash(git blame:*),Bash(git rev-parse:*),Bash(git ls-files:*),Bash(git grep:*),Bash(rg:*),Bash(ls:*),Bash(wc:*),Bash(node {script} ask-parent:*)", "--disallowedTools", "AskUserQuestion"],
      "write": ["--permission-mode", "dontAsk", "--allowedTools", "Read,Grep,Glob,Edit,Write,Bash", "--disallowedTools", "AskUserQuestion"]
    },
    "t3": { "driver": "claudeAgent", "options": { "effort": "{effort}" } }
  },
  "codex": {
    "command": "codex",
    "kind": "codex",
    "promptFirst": false,
    "model": ["-m", "{model}"],
    "effort": ["-c", "model_reasoning_effort={effort}"],
    "efforts": null,
    "runDir": ["--add-dir", "{run}"],
    "access": {
      "read": ["-a", "never", "-s", "workspace-write", "-c", "sandbox_workspace_write.network_access=true"],
      "write": ["-a", "never", "-s", "workspace-write", "-c", "sandbox_workspace_write.network_access=true"]
    },
    "t3": { "driver": "codex", "options": { "reasoningEffort": "{effort}" } }
  },
  "grok": {
    "command": "grok",
    "kind": "grok",
    "promptFirst": false,
    "model": ["-m", "{model}"],
    "effort": ["--reasoning-effort", "{effort}"],
    "efforts": ["low", "medium", "high", "xhigh"],
    "runDir": [],
    "access": {
      "read": ["--always-approve"],
      "write": ["--always-approve"]
    },
    "t3": { "driver": "grok", "options": { "reasoningEffort": "{effort}" } }
  },
  "agy": {
    "command": "agy",
    "kind": "agy",
    "promptFirst": false,
    "prompt": ["-i", "{prompt}"],
    "model": ["--model", "{model}"],
    "effort": null,
    "efforts": null,
    "runDir": ["--add-dir", "{run}"],
    "access": {
      "read": ["--dangerously-skip-permissions"],
      "write": ["--dangerously-skip-permissions"]
    },
    "t3": { "driver": "antigravity" }
  },
  "muse": {
    "command": "muse",
    "kind": "muse",
    "promptFirst": false,
    "model": ["--model", "{model}"],
    "effort": ["--reasoning-effort", "{effort}"],
    "efforts": ["minimal", "low", "medium", "high", "xhigh", "max"],
    "runDir": [],
    "access": {
      "read": ["--approval-mode", "never", "--trust-workspace", "--sandbox-network", "enabled"],
      "write": ["--yolo"]
    },
    "t3": { "driver": "muse", "options": { "reasoningEffort": "{effort}" } }
  }
}
